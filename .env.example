# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# Shared secret for internal/admin API routes (X-Internal-Key header).
# Required outside local — the app refuses to start without it. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=

# Separate shared secret for super-admin-only routes (X-Super-Admin-Key header).
# Required outside local. Generate the same way as INTERNAL_API_KEY.
SUPER_ADMIN_API_KEY=

# ---------------------------------------------------------------------------
# Auth (JWT login for the business/super-admin portals)
# ---------------------------------------------------------------------------
# Signing secret for login JWTs. Required outside local — the app refuses to
# start without it. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Credentials for the single shared super-admin portal login
# (POST /auth/super-admin/login). Required outside local.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------
# DATABASE_URL      -> Supavisor transaction pooler, port 6543. Used by the app.
# DATABASE_DIRECT_URL -> direct connection, port 5432. Used by Alembic only.
#
# Both must use the postgresql+asyncpg:// scheme.
# Grab them from: Supabase Dashboard -> Project Settings -> Database.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_DIRECT_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

DB_ECHO=false

# ---------------------------------------------------------------------------
# Supabase client (used for Storage only - media from WhatsApp/Telegram)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=media

# ---------------------------------------------------------------------------
# LLM provider — which brain runs the agent
# ---------------------------------------------------------------------------
# "anthropic" (Claude) or "gemini" (Google AI Studio free tier).
LLM_PROVIDER=anthropic

# ---------------------------------------------------------------------------
# Anthropic / agent (used when LLM_PROVIDER=anthropic)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Required only for identity-linked (Personal) keys; blank for a Workspace key.
ANTHROPIC_WORKSPACE_ID=
AGENT_MODEL=claude-sonnet-5
# low | medium | high | xhigh | max
AGENT_EFFORT=low
AGENT_MAX_TOKENS=16000
AGENT_MAX_ITERATIONS=8

# ---------------------------------------------------------------------------
# Gemini (used when LLM_PROVIDER=gemini) — free tier via Google AI Studio
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# Credential vault — encrypts game-account passwords at rest
# ---------------------------------------------------------------------------
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENC_KEY=

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (Meta)
# ---------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Echoed back during the GET webhook verification handshake.
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret - used to verify X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v21.0

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Value Telegram echoes in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Razorpay
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Mock payments — set true when Razorpay is unavailable (e.g. pending KYC).
# The agent issues a mock link that completes payment when opened. Never in prod.
# ---------------------------------------------------------------------------
PAYMENTS_MOCK=false
PUBLIC_BASE_URL=http://localhost:8000
